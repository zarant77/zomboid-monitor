PORT=3000
GAME_HOST=2.28.54.80
GAME_PORT=16261
CHECK_INTERVAL=5000
# Larger positive score jumps are ignored as likely journal restores.
MAX_KILL_GAIN_PER_CHECK=1000
# Fixed GMT+1. Use Europe/Berlin to follow German daylight saving time.
SERVER_TIMEZONE=+01:00
DATABASE_PATH=./data/zomboid.db

# Set a new unique value after each game server wipe, then restart the monitor.
# Changing this value clears all monitor statistics once. Keep it unchanged between wipes.
# SERVER_WIPE_ID=2026-10-06

# Exact browser origin used for Steam callbacks and cookies.
PUBLIC_ORIGIN=http://localhost:3000

# Steam display names and avatars (optional; server-only).
STEAM_API_KEY=
